<?xml version="1.0" encoding="UTF-8"?>
<!--
  WildFly deployment descriptor — generated by WaterRock.
  Excludes WildFly's built-in JSF 2.x so the WAR-bundled JSF 1.2
  implementation (jsf-impl-1.2_15.jar) is used instead.

  This is required because JSF 1.2 resource loading paths
  (faces/static/META-INF/...) are incompatible with JSF 2.x.

  Remove this file when migrating to JSF 2.x or later.
-->
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.2">
    <deployment>
        <exclude-subsystems>
            <subsystem name="jsf"/>
        </exclude-subsystems>
        <exclusions>
            <module name="javax.faces.api"/>
            <module name="com.sun.jsf-impl"/>
            <module name="org.jboss.as.jsf-injection"/>
        </exclusions>
    </deployment>
</jboss-deployment-structure>
