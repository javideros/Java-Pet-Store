            </description>
            <name>zoomLevel</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.Integer</type>
            </deferred-value>   
        </attribute>
        
    </tag>  
