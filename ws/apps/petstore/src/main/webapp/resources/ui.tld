    <!-- =================== BEGIN: tags for the Map Viewer component ========================== -->
    <tag>
        <description>
            Renders a map allowing visual display of locations
        </description>
        <name>mapViewer</name>
        <tag-class>com.sun.javaee.blueprints.components.ui.mapviewer.MapTag</tag-class>
        <body-content>empty</body-content>
        
        <attribute>
            <description>
                Binding to the component in a page bean.
            </description>
            <name>binding</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>com.sun.javaee.blueprints.components.ui.mapviewer.MapComponent</type>
            </deferred-value>   
        </attribute>
        
        <attribute>
            <description>
                A MapPoint representing the geographic
                location around which this map should
                be centered.
            </description>
            <name>center</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>com.sun.javaee.blueprints.components.ui.mapviewer.MapPoint</type>
            </deferred-value>   
        </attribute>
        
        <attribute>
            <description>
                Flag indicating that the map surface may
                be dragged after being rendered.
            </description>
            <name>draggingEnabled</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.Boolea</type>
            </deferred-value>   
        </attribute>
        
        <attribute>
