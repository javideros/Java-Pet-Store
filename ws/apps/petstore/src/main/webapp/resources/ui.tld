<taglib xmlns="http://java.sun.com/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd"
        version="2.1">
    
    
    <description>
        Java BluePrints AJAX Components Tag Library.
        This tag library contains tags for several useful JSF components.
    </description>
    <tlib-version>0.05</tlib-version>
    <short-name>bpui</short-name>
    <uri>http://java.sun.com/blueprints/ui</uri>
    
    <tag>
        <description>
            Cause the nested UIInput component to have its validation run 
            on the server side using AJAX.
        </description>
        <name>ajaxValidator</name>
        <tag-class>com.sun.javaee.blueprints.components.ui.taglib.AjaxValidatorTag</tag-class>
        <body-content>JSP</body-content>
        
        <attribute>
            <description>
                Component id of this component
            </description>
            <name>id</name>
            <required>false</required>
            <rtexprvalue>true</rtexprvalue>
        </attribute>
        
        <attribute>
            <description>
                JavaScript client identifier for where to put the messages.
            </description>
            <name>messageId</name>
            <required>true</required>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>
        </attribute>
        
        <attribute>
            <description>
                The JavaScript event on which to trigger this AJAX request
            </description>
            <name>eventHook</name>
            <required>false</required>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>
        </attribute>
        
    </tag>
    
    <!-- ===================== Begin: Tags for Popup Balloon component ============================ -->  
    <tag>
        <name>popupTag</name>
        <tag-class>com.sun.javaee.blueprints.components.ui.popup.PopupTag</tag-class>
        <body-content>scriptless</body-content>
        <attribute>
            <description>
                The attribute is used as a parameter to the JavaScript functions, show and hide that 
                are used by the developer to reference the popup. It is also used for other component specific 
                calls and a suffix to make HTML ids unique in the case where more than one JSF popup is used per page.
            </description>
            <name>id</name>
            <required>true</required>
            <rtexprvalue>false</rtexprvalue>
        </attribute>
        <attribute>
            <description>
                This attribute is used as the URL for the XMLHttpRequest. The string is meant to be concatenated with 
                the value that is handed in as the third parameter of the show function call of the referencing 
                component. See user documentation for more information.
            </description>
            <name>xmlHttpRequestURL</name>
            <required>true</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                This optional attribute represents a mapping of the element names that are returned from the XMLHttpRequest 
                call and the ids of the data elements that reside in the data portion of the popup. We also search 
                for the strings "img" and "image" in the id names to see if it may be an image, if so, we assume the 
                response data is a URL and populate the ".src" of the element.  See user documentation for more information.
            </description>
            <name>elementNamePairs</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                This optional attribute represents the return function to call once the AJAX call has been made.  This function will be responsible for
                populating the popup since specifying a retFunction by-passes the default functionality used with the "elementNamePairs" attribute.
            </description>
            <name>retFunction</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>
        </attribute>
        <attribute>
            <description>
                This optional attribute specifies the background color of the popup image.  Currently we have images for "blue", "black", "white" and "none".
            </description>
            <name>color</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>
        </attribute>
        <attribute>
            <description>
                This optional attribute specifies the width of the background popup image and is used in the calculation in the positioning of the arrow.  
                Currently we have images for "300", "400", "500" and "600" pixels. The default width is "300".
            </description>
            <name>width</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>
        </attribute>
        <attribute>
            <description>
                This optional attribute specifies whether the popup is displayed "before" or "after" the AJAX call has returned.  
                The default is to show the popup "before" the AJAX call is made.
            </description>
            <name>display</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>
        </attribute>
        <attribute>
            <description>
                This optional attribute specifies the time delay before the AJAX call is initiated in miliseconds.  
                This gives a better user experience because the popup isn't showing everytime the user just move the mouse over the links.
                The default is to execute the AJAX call after "1000" miliseconds (1 second).
            </description>
            <name>delay</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>
        </attribute>            
        <attribute>
            <description>
                This optional attribute specifies the expected height of the popup image when the data is displayed.  
                This value used in the calculation in the positioning of the arrow in relation to the popup.
                Currently, the default is set to 300.
            </description>
            <name>height</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>
        </attribute>        
    </tag>
    <!-- ===================== End: Tags for Popup Balloon component ============================ -->
    <!-- ===================== Begin Tags for File Upload component ============================ -->
    <tag>
        <name>fileUploadTag</name>
        <tag-class>com.sun.javaee.blueprints.components.ui.fileupload.FileUploadTag</tag-class>
        <body-content>scriptless</body-content>
        <attribute>
            <description>
                The required attribute is used to associate the components related functions.                
            </description>
            <name>id</name>
            <required>true</required>
            <rtexprvalue>false</rtexprvalue>
        </attribute>
        <attribute>
            <description>
                This optional attribute is used to reset the default storage directory to the specified fully 
                qualified directory.  The directory has to exist and be writable by the application.  The 
                default file up load directory is the domain's lib directory under "upload" (will be created 
                automatically), for example, if you installed your appserver at c:\glassfish and deployed your 
                application to "domain1", the default upload directory would be c:\glassfish\domains\domain1\lib\upload.                
            </description>
            <name>serverLocationDir</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                This optional attribute contains a return JavaScript function name that will be called when the 
                AJAX call returns.  The signature of the return function is "functionName(type, data, evt)" and is 
                consistent with the dojo.bind function "handle" attribute.  If this attribute is not populated, a 
                default JavaScript function will be called that will display the return statistics.            
            </description>
            <name>retFunction</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                This optional attribute specifies the return Mime type of the AJAX call.  The default value is "text/xml"                
            </description>
            <name>retMimeType</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                This optional attribute triggers a progress bar to be displayed in the HTML div tag with the 
                "id" name corresponding to this attributes value.  The div will be located by using the 
                document.getElementById  function, so it must be unique.            
            </description>
            <name>progressBarDivId</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                This optional attribute is the "id" of the submit button that submits the AJAX form.  The 
                Javascript functions will enable and disable the button if the "id" is entered.  This attribute 
                is only relevant when the "progressBarDivId" is present.
            </description>
            <name>progressBarSubmitId</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                This optional attribute is the size of the progress bar, the default is set to 40.  
                This number is multiplied by 10 and used as the progress bar size in pixels.  
                This attribute is only relevant when the "progressBarDivId" is present.
            </description>
            <name>progressBarSize</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                This optional attribute can invoke post processing through a deferred method that resides in a JSF 
                backing bean.  This allows the developer to execute custom functionality after the file(s)/data has 
                been uploaded.  The signature of the method is void(javax.faces.event.PhaseEvent, java.util.HashMap, 
                com.sun.javaee.blueprints.components.ui.fileupload.FileUploadStatus).    The method can elect to 
                send a custom response but calling the instance method, 
                com.sun.javaee.blueprints.components.ui.fileupload.FileUploadStatus.enableCustomReturn().  
                If this boolean flag isn't set then the default response will be sent.
            </description>
            <name>postProcessingMethod</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-method>
                <method-signature>
                    void postProcessingMethod(javax.faces.context.FacesContext, java.util.HashMap, com.sun.javaee.blueprints.components.ui.fileupload.FileUploadStatus)
                </method-signature>
            </deferred-method>  
        </attribute>
        
        <!-- copied from the html_basic.tld file for the form tag -->
        <attribute>
            <description>
                Flag indicating whether or not this component should be rendered
                (during Render Response Phase), or processed on any subsequent
                form submit.
            </description>
            <name>rendered</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                List of content types that a server processing this form
                will handle correctly 
            </description>
            <name>accept</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                List of character encodings for input data
                that are accepted by the server processing
                this form.
            </description>
            <name>acceptcharset</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                Direction indication for text that does not inherit directionality.
                Valid values are "LTR" (left-to-right) and "RTL" (right-to-left).
            </description>
            <name>dir</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                Code describing the language used in the generated markup
                for this component.
            </description>
            <name>lang</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                Javascript code executed when a pointer button is
                clicked over this element.
            </description>
            <name>onclick</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                Javascript code executed when a pointer button is
                double clicked over this element.
            </description>
            <name>ondblclick</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                Javascript code executed when a key is
                pressed down over this element.
            </description>
            <name>onkeydown</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                Javascript code executed when a key is
                pressed and released over this element.
            </description>
            <name>onkeypress</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                Javascript code executed when a key is
                released over this element.
            </description>
            <name>onkeyup</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                Javascript code executed when a pointer button is
                pressed down over this element.
            </description>
            <name>onmousedown</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                Javascript code executed when a pointer button is
                moved within this element.
            </description>
            <name>onmousemove</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                Javascript code executed when a pointer button is
                moved away from this element.
            </description>
            <name>onmouseout</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                Javascript code executed when a pointer button is
                moved onto this element.
            </description>
            <name>onmouseover</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                Javascript code executed when a pointer button is
                released over this element.
            </description>
            <name>onmouseup</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                Javascript code executed when this form is reset.
            </description>
            <name>onreset</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                Javascript code executed when this form is submitted.
            </description>
            <name>onsubmit</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                CSS style(s) to be applied when this component is rendered.
            </description>
            <name>style</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                Space-separated list of CSS style class(es) to be applied when
                this element is rendered.  This value must be passed through
                as the "class" attribute on generated markup.
            </description>
            <name>styleClass</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                Name of a frame where the response
                retrieved after this form submit is to
                be displayed.
            </description>
            <name>target</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                Advisory title information about markup elements generated
                for this component.
            </description>
            <name>title</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <description>
                The value binding expression linking this component to a property in a backing bean
            </description>
            <name>binding</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>extended by javax.faces.component.html.HtmlForm</type>
            </deferred-value>   
        </attribute>
    </tag>
    <!-- ===================== End Tags for File Upload component ============================ -->
    
    <!-- ===================== Begin RSS Reader ============================== -->
    <tag>
        <description>
            Rss Bar
        </description>
        <name>rssBar</name>
        <tag-class>com.sun.javaee.blueprints.components.ui.rss.RssBarTag</tag-class>
        <body-content>JSP</body-content>
        <attribute>
            <name>url</name>
            <required>true</required>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <name>itemCount</name>
            <required>false</required>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <name>backgroundImage</name>
            <required>false</required>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <name>color</name>
            <required>false</required>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <name>fontSize</name>
            <required>false</required>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <name>hoverColor</name>
            <required>false</required>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <name>speed</name>
            <required>false</required>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <name>title</name>
            <required>false</required>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
    </tag>
    <tag>
        <description>
            Rss Reader
        </description>
        <name>rssreader</name>
        <tag-class>com.sun.javaee.blueprints.components.ui.rss.RssReaderTag</tag-class>
        <body-content>JSP</body-content>
        <attribute>
            <name>alt</name>
            <required>false</required>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
    </tag>
    
    <tag>
        <description>specifying rss category</description>
        <name>rsscategory</name>
        <tag-class>com.sun.javaee.blueprints.components.ui.rss.RssCategoryTag</tag-class>
        <body-content>JSP</body-content>
        <attribute>
            <name>title</name>
            <required>true</required>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
    </tag>
    <tag>
        <description>specifying rss feed</description>
        <name>rssfeed</name>
        <tag-class>com.sun.javaee.blueprints.components.ui.rss.RssFeedTag</tag-class>
        <body-content>empty</body-content>
        <attribute>
            <name>title</name>
            <required>true</required>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        <attribute>
            <name>url</name>
            <required>true</required>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
    </tag>
    <!-- ======================== END RSS READER ======================== -->
    
    <!-- ============= BEGIN:  tags for the AutoComplete component =========== -->
    <tag>
        <description>
            Renders a text field with automatic completion.
        </description>
        <name>autoComplete</name>
        <tag-class>com.sun.javaee.blueprints.components.ui.autocomplete.AutoCompleteTag</tag-class>
        <body-content>empty</body-content>
        
        <attribute>
            <description>      
                Access key that, when pressed, transfers focus
                to this element.
            </description>
            <name>accesskey</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        
        <attribute>
            <description>
                Alternate textual description of the
                element rendered by this component.
            </description>
            <name>alt</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        
        <attribute>
            <description>
                Binding to the component in a page bean.
            </description>
            <name>binding</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>com.sun.javaee.blueprints.components.ui.autocomplete.AutoCompleteComponent</type>
            </deferred-value>   
        </attribute>
        
        <attribute>
            <description>
                Method binding expression which points to a method
                taking a FacesContext and a prefix String, and returning
                a String[] which will be displayed as completion results
                for the given prefix.
            </description>
            <name>completionMethod</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-method>
                <method-signature>void completeCity(javax.faces.context.FacesContext, java.lang.String, com.sun.javaee.blueprints.components.ui.autocomplete.CompletionResult)</method-signature>
            </deferred-method>   
        </attribute>
        
        <attribute>
            <description>
                Converter instance registered with this component.
            </description>
            <name>converter</name>
            <required>false</required>
            <rtexprvalue>false</rtexprvalue>
            <deferred-value>
                <type>java.lang.String</type>
            </deferred-value>   
        </attribute>
        
        <attribute>
            <description>
