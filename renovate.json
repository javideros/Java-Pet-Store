{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", "replacements:all"],
  "prHourlyLimit": 10,
  "prConcurrentLimit": 20,
  "recreateWhen": "always",
  "packageRules": [
    {
      "matchManagers": ["maven"],
      "enabled": true
    },
    {
      "description": "Java EE 5→6 migration: constrain to EE 6 APIs (javax.* namespace, version <=3.0.*)",
      "matchDatasources": ["maven"],
      "matchPackagePatterns": [
        "^javax\\.servlet:servlet-api$",
        "^javax\\.faces:jsf-api$",
        "^javax\\.persistence:persistence-api$",
        "^javax\\.el:el-api$",
        "^javax\\.transaction:javax\\.transaction-api$",
        "^javax\\.ejb:javax\\.ejb-api$",
        "^javax\\.mail:mail$",
        "^javax\\.validation:validation-api$",
        "^javax\\.ws\\.rs:javax\\.ws\\.rs-api$"
      ],
      "allowedVersions": "<=3.0.*"
    },
    {
      "description": "Java EE 5→6: coordinate renames that Renovate cannot auto-detect (dead artifact, new Maven coordinates)",
      "matchPackageNames": ["javax.servlet:servlet-api"],
      "replacementName": "javax.servlet:javax.servlet-api",
      "replacementVersion": "3.0.1"
    },
    {
      "description": "Java EE 5→6: JSF coordinate rename (jsf-api is dead, javax.faces-api is EE 6)",
      "matchPackageNames": ["javax.faces:jsf-api"],
      "replacementName": "javax.faces:javax.faces-api",
      "replacementVersion": "2.1"
    },
    {
      "description": "Java EE 5→6: JPA — no coordinate rename at EE 6 (javax.persistence-api starts at 2.2/EE 7). Constrain to <=1.0.2",
      "matchPackageNames": ["javax.persistence:persistence-api"],
      "allowedVersions": "<=1.0.2"
    },
    {
      "description": "Pin JSF 1.2 impl versions (Shale remoting incompatible with 1.2-20+). Will be replaced by JSF 2.0 migration.",
      "matchPackageNames": ["javax.faces:jsf-api", "javax.faces:jsf-impl"],
      "enabled": false
    },
    {
      "description": "Java 6 compat: constrain commons-io to last Java 6 compatible release (2.7+ requires Java 8)",
      "matchPackageNames": ["commons-io:commons-io"],
      "allowedVersions": "<=2.6"
    },
    {
      "description": "Java 6 compat: commons-fileupload 2.x is Jakarta EE 9+",
      "matchPackageNames": ["commons-fileupload:commons-fileupload"],
      "allowedVersions": "<=1.5"
    },
    {
      "description": "Java 6 compat: commons-logging",
      "matchPackageNames": ["commons-logging:commons-logging"],
      "allowedVersions": "<=1.3.4"
    },
    {
      "description": "Java 6 compat: Lucene 4.0+ requires Java 7, 5.0+ requires Java 8",
      "matchPackageNames": ["org.apache.lucene:lucene-core"],
      "allowedVersions": "<=3.6.2"
    },
    {
      "description": "Java 6 compat: JUnit 4.13.2 is the last release, backward compat with JUnit 3 TestCase",
      "matchPackageNames": ["junit:junit"],
      "allowedVersions": "<=4.13.2"
    },
    {
      "description": "Dead coordinate: jdom 2.x is a different artifact (org.jdom2:jdom2)",
      "matchPackageNames": ["org.jdom:jdom"],
      "enabled": false
    },
    {
      "description": "Dead coordinates: rome artifacts moved to com.rometools",
      "matchPackagePatterns": ["^rome:rome"],
      "enabled": false
    },
    {
      "description": "Retired: Apache Shale was retired in 2009",
      "matchPackageNames": ["org.apache.shale:shale-remoting"],
      "enabled": false
    },
    {
      "description": "Retired: httpunit has no further releases",
      "matchPackageNames": ["httpunit:httpunit"],
      "enabled": false
    },
    {
      "description": "Java 6 compat: nekohtml later versions change coordinates",
      "matchPackageNames": ["net.sourceforge.nekohtml:nekohtml"],
      "allowedVersions": "<=1.9.22"
    },
    {
      "description": "Pin WildFly plugin to 2.1.0.Final (compatible with WildFly 8.x for EE 6)",
      "matchPackageNames": ["org.wildfly.plugins:wildfly-maven-plugin"],
      "enabled": false
    },
    {
      "description": "Local/unknown artifacts: disable Renovate for non-Central dependencies",
      "matchPackagePatterns": ["^local:"],
      "enabled": false
    }
  ],
  "forkProcessing": "enabled"
}
